SESSION_SECRET=YomCB1+PuZQFcJW7lScDXEZteKIuh1UktXDJVndRw5Y=

# Set to 'false' for local development over plain HTTP
SESSION_COOKIE_SECURE=false

# --- ML inference proxy (routes/ml.js) --------------------------------------
ML_SERVICE_URL=http://localhost:8001
ML_TIMEOUT_MS=30000
# Max bytes accepted for one scanned image (memory storage: buffered in RAM)
ML_MAX_UPLOAD_MB=10
# top_k is clamped to 1..ML_MAX_TOP_K rather than forwarded raw
ML_MAX_TOP_K=10
# Scan quota. Fixed window, charged on attempt, enforced from MySQL.
ML_RATE_LIMIT_MAX=30
ML_RATE_LIMIT_WINDOW_MIN=10
# Retention windows for the Mongo usage feed and the image-review audit
ML_RETENTION_DAYS=365
ML_REJECTED_RETENTION_DAYS=365

# --- Discovery loop (the botanist queue) -------------------------------------
# Both caps count LIVE state, never lifetime history: a claim while its report is
# unresolved, a report while it is pending. So neither permanently exhausts an
# account, and both are enforced server-side in the same transaction as the write
# they guard.
DISCOVERIES_MAX_CLAIMS=20
DISCOVERIES_MAX_OPEN_REPORTS=10
# Cancel is bounded by a grace window and filing by a cooldown, on two different
# paths: together they let a user fix a mistake immediately while capping churn.
DISCOVERIES_CANCEL_GRACE_HOURS=24
DISCOVERIES_REPORT_COOLDOWN_MIN=10
# Also the voting-eligibility window. Ninety days is chosen so expiry cannot cost
# legitimate work: nothing reasonable takes three months on one record.
DISCOVERIES_CLAIM_STALE_DAYS=90
# A CEILING on the "not a plant" quorum, not the quorum itself. The effective
# threshold is max(2, min(this, ceil(activeBotanists / 2))), so it always means
# "more than one opinion" and never "everybody". A non-numeric value falls back
# to 5.
DISCOVERIES_NOT_A_PLANT_VOTES=5
# Photos are purged for every CLOSED report (cancelled, denied, rejected) while
# the report row and its discovery_votes are kept indefinitely. Cancel deletes at
# once; the others after this window.
DISCOVERY_CLOSED_PHOTO_DAYS=90
